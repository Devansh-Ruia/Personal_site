---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  article?: boolean;
  articleDate?: Date;
  noindex?: boolean;
}

const {
  title,
  description = 'Devansh Ruia studies computer science and mechanistic interpretability.',
  article = false,
  articleDate,
  noindex = false,
} = Astro.props;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImageUrl = Astro.site ? new URL('/social-card.png', Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content="Devansh Ruia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {socialImageUrl && <meta property="og:image:width" content="1200" />}
    {socialImageUrl && <meta property="og:image:height" content="630" />}
    {socialImageUrl && <meta property="og:image:alt" content="Devansh Ruia" />}
    {articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}
    <meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {socialImageUrl && <meta name="twitter:image:alt" content="Devansh Ruia" />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="wrap">
      <nav class="site" aria-label="Primary">
        <a class="brand" href="/">Devansh Ruia</a>
        <a href="/projects/">Projects</a>
        <a href="/fv/">Function vectors</a>
        <a href="/about/">About</a>
      </nav>
      <main id="content">
        <slot />
      </main>
    </div>
  </body>
</html>
