---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) =>
    (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0) ||
    a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout title="Projects | Devansh Ruia" description="Project writeups by Devansh Ruia.">
  <h1>Projects</h1>
  <p class="muted">
    Notes on interpretability experiments and software projects. Dates are omitted where the
    underlying record does not establish one.
  </p>

  {posts.length === 0 && <p class="muted">No published writeups yet.</p>}

  <ul class="project-list">
    {
      posts.map((post) => (
        <li>
          <a href={`/projects/${post.id}/`}>{post.data.title}</a>
          <div class="project-summary">{post.data.summary}</div>
          <div class="project-meta">
            {post.data.date && (
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                  timeZone: 'UTC',
                })}
              </time>
            )}
            {post.data.tags.map((tag) => (
              <span class="status">{tag}</span>
            ))}
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>
